{
  "name": "solana-fhe-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Client SDK and CLI: RLWE encryption, the off-chain FHE engine, and the on-chain client.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
