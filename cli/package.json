    "demo": "tsx src/cli.ts demo",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.0",
    "node-seal": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "tsx": "4.19.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
